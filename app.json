{
  "expo": {
    "name": "ReBlocks",
    "slug": "reblocks-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matersvendev.reblocksmobile",
      "icon": {
        "light": "./assets/assets/ios-light.png",
        "dark": "./assets/assets/ios-dark.png",
        "tinted": "./assets/assets/ios-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/assets/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/assets/adaptive-icon-background.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.matersvendev.reblocksmobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "60b4f53a-4265-41c7-8acb-ffa775b5ff13"
      }
    }
  }
}
